# Copy this file to /opt/chatbot/.env on the VPS and replace every CHANGE_ME.
# Never commit the populated .env file.

# Database. URL-encode special characters used inside DATABASE_URL.
MYSQL_DATABASE=chatbot
MYSQL_USER=chatbot
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_DATABASE_ROOT_PASSWORD
DATABASE_URL=mysql://chatbot:CHANGE_ME_DATABASE_PASSWORD@mysql:3306/chatbot

# Application and authentication.
NODE_ENV=production
PORT=3000
BACKEND_URL=https://danoa.ir
AUTH_JWT_SECRET=CHANGE_ME_MINIMUM_32_RANDOM_CHARACTERS
ADMIN_JWT_SECRET=CHANGE_ME_DIFFERENT_MINIMUM_32_RANDOM_CHARACTERS
ADMIN_API_KEY=CHANGE_ME_ADMIN_API_KEY
ADMIN_PANEL_PATH=/admin-secure-9x7k
ADMIN_COOKIE_NAME=admin_token

# Sign in with Viana. Before installing this block, create a separate
# "Danoa Production" client in Viana with domain https://danoa.ir and exact
# callback https://danoa.ir/api/auth/viana/callback. Fill both credential
# values through the server's secret channel; startup intentionally fails
# while either value is empty.
VIANA_OAUTH_ENABLED=true
VIANA_ENVIRONMENT=production
VIANA_FRONTEND_URL=https://vianaland.ir
VIANA_DISCOVERY_URL=https://vianaland.ir/.well-known/openid-configuration
VIANA_API_BASE_URL=https://vianaland.ir/api/v1
VIANA_AUTHORIZATION_URL=https://vianaland.ir/oauth/continue
VIANA_TOKEN_URL=https://vianaland.ir/api/v1/identity/token
VIANA_STUDENT_PROFILE_URL=https://vianaland.ir/api/v1/students/me
VIANA_SCOPES=openid profile student.self:read students.sensitive:read
VIANA_CLIENT_ID=
VIANA_CLIENT_SECRET=
VIANA_REDIRECT_URI=https://danoa.ir/api/auth/viana/callback
VIANA_POST_LOGIN_PATH=/
VIANA_HTTP_TIMEOUT_MS=10000
APP_ALLOWED_ORIGINS=https://danoa.ir
DANOA_SESSION_IDLE_TIMEOUT_SECONDS=86400
DANOA_SESSION_ABSOLUTE_TIMEOUT_SECONDS=2592000

# Existing chat/image providers. Copy the real values from the current secret
# environment without putting them in Git.
METIS_API_KEY=
METIS_CHAT_API_KEY=
METIS_VISION_API_KEY=
METIS_INTENT_ROUTER_API_KEY=
METIS_INPUT_OPTIMIZER_API_KEY=
METIS_CONVERSATION_TITLE_API_KEY=
METIS_CONVERSATION_MEMORY_API_KEY=
METIS_IMAGE_API_KEY=
GEMINI_CHAT_API_KEY=
GEMINI_IMAGE_API_KEY=
GEMINI_API_KEY=
XAI_IMAGE_API_KEY=
METIS_OPENAI_BASE_URL=https://api.metisai.ir/openai/v1
OPENAI_MODEL=gpt-4o-mini
# Backpressure for authenticated chat requests.
CHAT_RATE_LIMIT_PER_MINUTE=30
CHAT_MAX_CONCURRENT_PER_USER=2
CHAT_MAX_CONCURRENT_GLOBAL=20
# Per-user image upload burst limit.
UPLOAD_IMAGE_RATE_LIMIT_PER_MINUTE=20
IMAGE_PROVIDER=metis
IMAGE_BASE_URL=https://api.metisai.ir
IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_RESOLUTION=1K
IMAGE_ASPECT_RATIO=1:1
IMAGE_OUTPUT_FORMAT=png
IMAGE_SAFETY_FILTER_LEVEL=block_only_high
IMAGE_PUBLIC_BASE_URL=/api/images/serve
IMAGE_MAX_DOWNLOAD_MB=10
# Comma-separated exact HTTPS hostnames used by provider result files.
# Leave empty when results come from IMAGE_BASE_URL itself; otherwise set the
# verified CDN/object-storage hostname before enabling image generation.
IMAGE_RESULT_ALLOWED_HOSTS=
# Bound image bursts and unfinished provider jobs.
IMAGE_RATE_LIMIT_PER_MINUTE=6
IMAGE_MAX_ACTIVE_JOBS=6
IMAGE_MAX_ACTIVE_JOBS_PER_USER=2

# Separate image-to-image module. Keep this false until migration, Metis key,
# and the exact result CDN hostname have been verified in production.
IMAGE_TO_IMAGE_ENABLED=false
METIS_IMAGE_TO_IMAGE_API_KEY=
IMAGE_TO_IMAGE_BASE_URL=https://api.metisai.ir
IMAGE_TO_IMAGE_MODEL=nano-banana
IMAGE_TO_IMAGE_RESOLUTION=1K
IMAGE_TO_IMAGE_OUTPUT_FORMAT=jpg
IMAGE_TO_IMAGE_STORAGE_DIR=/var/lib/danoa/image-to-image
IMAGE_TO_IMAGE_RESULT_ALLOWED_HOSTS=api.metisai.ir
# embedded = API process consumes jobs; dedicated = npm run worker:image-to-image;
# disabled = no image-to-image worker consumes jobs.
IMAGE_TO_IMAGE_WORKER_MODE=embedded
IMAGE_TO_IMAGE_WORKER_RUN_IMMEDIATELY=true
IMAGE_TO_IMAGE_WORKER_INTERVAL_MS=3000
IMAGE_TO_IMAGE_WORKER_LEASE_SECONDS=180
CONVERSATION_TITLE_ENABLED=true
INPUT_OPTIMIZER_ENABLED=true

# SMS/payment/bot settings already used by the site.
IPPANEL_API_KEY=
IPPANEL_PATTERN_CODE=
IPPANEL_SENDER=3000505
OTP_EXPIRE=120
BALE_BOT_TOKEN=
BALE_WEBHOOK_PUBLIC_URL=https://danoa.ir
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
ZARINPAL_CALLBACK_URL=https://danoa.ir/api/payment/verify
FRONTEND_PAYMENT_RESULT_URL=https://danoa.ir/payment/result

# BananaAI video generation. The route is pinned to grok-imagine-video and has
# no Metis fallback. Keep the provider-input mode set to gateway on the VPS.
VIDEO_GENERATION_ENABLED=1
VIDEO_GENERATION_ACTIVATION_EXPECTED=1
AI_VIDEO_ROUTING_ENABLED=1
BANANAAI_API_KEY=CHANGE_ME_BANANAAI_API_KEY
BANANAAI_BASE_URL=https://bananaai.ir
BANANAAI_VIDEO_RESULT_ALLOWED_HOSTS=c155795.parspack.net
BANANAAI_VIDEO_RESULT_ALLOWED_PATH_PREFIXES=/c155795/bananaai/generated/videos/
BANANAAI_REQUEST_TIMEOUT_MS=10000
BANANAAI_STATUS_TIMEOUT_MS=30000
BANANAAI_T2V_MAX_PROMPT_LENGTH=8000
BANANAAI_I2V_MAX_PROMPT_LENGTH=2000

# Full T2V policy is sent to Gemini as systemInstruction and the original user
# request is sent separately. Only the validated provider prompt reaches BananaAI.
T2V_SYSTEM_PROMPT_VERSION=text-to-video-runtime-v2
# If the VPS cannot reach bananaai.ir directly, set an HTTP CONNECT proxy here.
# Leave empty when direct HTTPS egress is available.
BANANAAI_PROXY_URL=
# Avoid broken IPv6 routes on hosts where BananaAI is reachable over IPv4.
BANANAAI_FORCE_IPV4=true

# The generic result contract is intentionally the same BananaAI contract. It
# prevents any non-Banana result host from being downloaded by the video stack.
VIDEO_RESULT_ALLOWED_HOSTS=c155795.parspack.net
VIDEO_RESULT_ALLOWED_PATH_PREFIXES=/c155795/bananaai/generated/videos/
VIDEO_RESULT_ALLOWED_PORTS=443
VIDEO_RESULT_MAX_REDIRECTS=0
VIDEO_RESULT_MAX_BYTES=104857600
VIDEO_RESULT_DOWNLOAD_TIMEOUT_MS=60000
# Banana result streaming uses separate deadlines. A zero total timeout means
# continuous video bytes may exceed one minute without being aborted.
VIDEO_RESULT_CONNECT_TIMEOUT_MS=15000
VIDEO_RESULT_HEADERS_TIMEOUT_MS=30000
VIDEO_RESULT_IDLE_TIMEOUT_MS=90000
VIDEO_RESULT_TOTAL_TIMEOUT_MS=0
VIDEO_STORAGE_TEMP_MAX_AGE_MINUTES=60
VIDEO_STORAGE_MAX_ATTEMPTS=4
VIDEO_STORAGE_RETRY_BASE_DELAY_MS=10000
VIDEO_STORAGE_RETRY_MAX_DELAY_MS=300000

# Embedded worker: one process owns API + queue processing in this Docker setup.
VIDEO_GENERATION_WORKER_MODE=embedded
VIDEO_GENERATION_WORKER_ENABLED=true
VIDEO_GENERATION_WORKER_RUN_IMMEDIATELY=true
VIDEO_GENERATION_WORKER_INTERVAL_MS=5000
VIDEO_GENERATION_WORKER_BATCH_SIZE=2
VIDEO_GENERATION_WORKER_LEASE_MS=60000
VIDEO_GENERATION_WORKER_MAX_ATTEMPTS=40
VIDEO_JOB_TIMEOUT_MINUTES=30
VIDEO_POLL_BASE_DELAY_MS=5000
VIDEO_POLL_MAX_DELAY_MS=30000

# Private, signed, five-minute URL served only by danoa.ir for BananaAI to read.
VIDEO_PROVIDER_INPUT_MODE=gateway
VIDEO_PROVIDER_INPUT_PUBLIC_BASE_URL=https://danoa.ir
VIDEO_PROVIDER_INPUT_SIGNING_SECRET=CHANGE_ME_64_HEX_CHARACTERS
VIDEO_PROVIDER_INPUT_TTL_SECONDS=900
VIDEO_INPUT_MAX_BYTES=5242880
VIDEO_INPUT_RETENTION_MINUTES=60

# Administrative mutation guards remain off during normal runtime.
ALLOW_VIDEO_MODEL_ACTIVATION=0
ALLOW_VIDEO_QUOTA_CONFIGURATION=0
RUN_METIS_RESULT_RECOVERY=0
