# Keep this file secret-free. Do not paste signed result URLs here.
METIS_API_KEY=
METIS_BASE_URL=https://api.metisai.ir
METIS_REQUEST_TIMEOUT_MS=120000
METIS_STATUS_TIMEOUT_MS=30000
METIS_DOWNLOAD_TIMEOUT_MS=60000

VIDEO_GENERATION_ENABLED=0
VIDEO_GENERATION_WORKER_MODE=dedicated
VIDEO_GENERATION_WORKER_INTERVAL_MS=30000
VIDEO_GENERATION_WORKER_BATCH_SIZE=5
VIDEO_GENERATION_WORKER_LEASE_MS=60000
VIDEO_GENERATION_WORKER_MAX_ATTEMPTS=20

VIDEO_STORAGE_ROOT=/var/lib/danoa/video-results
VIDEO_STORAGE_TEMP_ROOT=/var/lib/danoa/video-results/.tmp
VIDEO_MAX_FILE_SIZE_BYTES=104857600
VIDEO_RESULT_ALLOWED_HOSTS=api.metisai.ir
VIDEO_RESULT_ALLOWED_PATH_PREFIXES=/api/tpsgsbxstoragecontainer/router/tpsgsbxstoragecontainer/router/
VIDEO_RESULT_ALLOWED_PORTS=443
VIDEO_RESULT_MAX_REDIRECTS=0

# Model activation and plan quota configuration are intentionally separate.
ALLOW_VIDEO_MODEL_ACTIVATION=0
ALLOW_VIDEO_QUOTA_CONFIGURATION=0
RUN_METIS_RESULT_RECOVERY=0
