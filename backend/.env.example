METIS_API_KEY=your-metis-api-key
METIS_INTENT_ROUTER_API_KEY=
METIS_INPUT_OPTIMIZER_API_KEY=
METIS_CONVERSATION_TITLE_API_KEY=
CONVERSATION_TITLE_ENABLED=true
CONVERSATION_TITLE_MODEL=gemini-2.5-flash-lite
CONVERSATION_TITLE_TEMPERATURE=0
CONVERSATION_TITLE_TIMEOUT_MS=6000
CONVERSATION_TITLE_MAX_RETRIES=1
CONVERSATION_TITLE_MAX_OUTPUT_TOKENS=64
CONVERSATION_TITLE_MAX_CHARACTERS=40
CONVERSATION_TITLE_VERSION=1
INPUT_OPTIMIZER_ENABLED=true
INPUT_OPTIMIZER_MODEL=gemini-2.5-flash-lite-preview
INPUT_OPTIMIZER_TIMEOUT_MS=3500
METIS_CONVERSATION_MEMORY_API_KEY=
METIS_OPENAI_BASE_URL=https://api.metisai.ir/openai/v1
OPENAI_MODEL=gpt-4o-mini
GAPGPT_TIMEOUT_MS=30000
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Optional. Leave unset unless Google documents a different Gemini API base URL.
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ADMIN_API_KEY=your-secret-key
ADMIN_JWT_SECRET=change-this-secret
ADMIN_PANEL_PATH=/admin-secure-9x7k
ADMIN_COOKIE_NAME=admin_token
PORT=4000
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB_NAME"
CONVERSATION_MEMORY_STORAGE_DIR=

# Danoa authentication and Sign in with Viana.
# Keep the real client secret only in backend/.env (ignored by Git).
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
VIANA_OAUTH_ENABLED=false
VIANA_ENVIRONMENT=development
# Endpoints are read and verified from OpenID Connect Discovery; don't hard-code them.
VIANA_DISCOVERY_URL=https://vianaland.ir/.well-known/openid-configuration
VIANA_API_URL=https://vianaland.ir/api/v1
VIANA_CLIENT_ID=
VIANA_CLIENT_SECRET=
VIANA_REDIRECT_URI=http://localhost:5173/api/auth/viana/callback
VIANA_POST_LOGIN_PATH=/
VIANA_HTTP_TIMEOUT_MS=10000
APP_ALLOWED_ORIGINS=http://localhost:5173
DANOA_SESSION_IDLE_TIMEOUT_SECONDS=86400
# Backward-compatible absolute session lifetime alias.
DANOA_SESSION_TTL_SECONDS=2592000
DANOA_SESSION_ABSOLUTE_TIMEOUT_SECONDS=2592000

VIDEO_WORKER_ENABLED=false
VIDEO_WORKER_PROCESS_MODE=disabled
VIDEO_WORKER_RUN_IMMEDIATELY=false
VIDEO_WORKER_INTERVAL_MS=30000
VIDEO_WORKER_BATCH_SIZE=5
VIDEO_WORKER_LEASE_MS=60000
VIDEO_JOB_TIMEOUT_MINUTES=30
VIDEO_MAX_POLL_ATTEMPTS=20
VIDEO_POLL_BASE_DELAY_MS=5000
VIDEO_POLL_MAX_DELAY_MS=60000
VIDEO_WORKER_SHUTDOWN_TIMEOUT_MS=10000
VIDEO_GENERATION_ENABLED=0
VIDEO_GENERATION_ACTIVATION_EXPECTED=0
VIDEO_STORAGE_ROOT=
VIDEO_STORAGE_TEMP_ROOT=
VIDEO_RESULT_MAX_BYTES=104857600
VIDEO_RESULT_DOWNLOAD_TIMEOUT_MS=60000
VIDEO_RESULT_MAX_REDIRECTS=0
VIDEO_RESULT_ALLOWED_HOSTS=c155795.parspack.net
VIDEO_RESULT_ALLOWED_PATH_PREFIXES=/c155795/bananaai/generated/videos/
VIDEO_RESULT_ALLOWED_PORTS=443
VIDEO_STORAGE_TEMP_MAX_AGE_MINUTES=60
VIDEO_STORAGE_MAX_ATTEMPTS=4
VIDEO_STORAGE_RETRY_BASE_DELAY_MS=10000
VIDEO_STORAGE_RETRY_MAX_DELAY_MS=300000
AI_VIDEO_ROUTING_ENABLED=1
BANANAAI_API_KEY=
BANANAAI_BASE_URL=https://bananaai.ir
BANANAAI_VIDEO_RESULT_ALLOWED_HOSTS=c155795.parspack.net
BANANAAI_VIDEO_RESULT_ALLOWED_PATH_PREFIXES=/c155795/bananaai/generated/videos/
VIDEO_INPUT_STORAGE_ROOT=
VIDEO_INPUT_MAX_BYTES=5242880
VIDEO_INPUT_RETENTION_MINUTES=60
VIDEO_PROVIDER_INPUT_SIGNING_SECRET=
VIDEO_PROVIDER_INPUT_PUBLIC_BASE_URL=https://danoa.ir
VIDEO_PROVIDER_INPUT_TTL_SECONDS=900
VIDEO_PROVIDER_GATEWAY_PORT=3100
VIDEO_PROVIDER_INPUT_MODE=gateway
# Optional local-development fallback only. Production danoa.ir uses gateway.
VIDEO_PROVIDER_INPUT_UPLOAD_BASE_URL=https://api.metisai.ir
VIDEO_PROVIDER_INPUT_UPLOAD_ALLOWED_HOSTS=api.metisai.ir
VIDEO_PROVIDER_INPUT_UPLOAD_ALLOWED_PATH_PREFIXES=/api/tpsgsbxstoragecontainer/router/tpsgsbxstoragecontainer/router/
VIDEO_PROVIDER_INPUT_UPLOAD_TIMEOUT_MS=120000

IPPANEL_API_KEY=
IPPANEL_PATTERN_CODE=
IPPANEL_SENDER=3000505
OTP_EXPIRE=120
# Local-only developer login. Never enable this on a server reachable by others.
LOCAL_DEV_SESSION_ENABLED=false
